{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dss/schemas/audit-independent-recovery-anchor-v1.schema.json",
  "title": "Independent recovery anchor v1",
  "description": "Structural contract for caller-authenticated, independently retained recovery minima. This schema does not authenticate the anchor or prove source independence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "anchor_id",
    "source_reference",
    "minimum_pin_revision",
    "minimum_witness_sequence",
    "minimum_checkpoint_sequence"
  ],
  "properties": {
    "record_version": {
      "const": "audit-independent-recovery-anchor/v1"
    },
    "anchor_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "minimum_pin_revision": {
      "type": "integer",
      "minimum": 0
    },
    "minimum_witness_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_checkpoint_sequence": {
      "type": "integer",
      "minimum": 0
    }
  }
}
