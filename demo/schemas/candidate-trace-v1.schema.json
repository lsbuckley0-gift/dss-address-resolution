{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dss/candidate-trace-v1.schema.json",
  "title": "∂ss synthetic candidate trace export (v1)",
  "description": "A JSON array produced by demo/dss_demo.py --json-out. Synthetic demonstration output only.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "case_id",
      "intended",
      "candidate_count",
      "candidate_ids",
      "candidate_trace",
      "selected_candidate",
      "selected_candidate_index",
      "operation",
      "return_check",
      "terminal_state",
      "reason_code",
      "evidence_class",
      "reason_codes",
      "trace_id",
      "ruleset_version",
      "trace_schema_version",
      "normalisation_rule",
      "candidate_trace_audit"
    ],
    "properties": {
      "case_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "intended": {},
      "candidate_count": {
        "type": "integer",
        "minimum": 0
      },
      "candidate_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "candidate_trace": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_id",
            "candidate_index",
            "field_comparisons",
            "street_edit_distance_at_most_one",
            "retrieval",
            "protected_field_checks",
            "disposition",
            "reason_codes"
          ],
          "properties": {
            "candidate_id": {
              "type": "string"
            },
            "candidate_index": {
              "type": "integer",
              "minimum": 0
            },
            "field_comparisons": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "premise": {
                  "$ref": "#/$defs/fieldComparison"
                },
                "street": {
                  "$ref": "#/$defs/fieldComparison"
                },
                "locality": {
                  "$ref": "#/$defs/fieldComparison"
                },
                "postcode": {
                  "$ref": "#/$defs/fieldComparison"
                }
              },
              "anyOf": [
                {
                  "maxProperties": 0
                },
                {
                  "required": [
                    "premise",
                    "street",
                    "locality",
                    "postcode"
                  ]
                }
              ]
            },
            "street_edit_distance_at_most_one": {
              "type": "boolean"
            },
            "retrieval": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eligible",
                "reason_codes"
              ],
              "properties": {
                "eligible": {
                  "type": "boolean"
                },
                "reason_codes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "protected_field_checks": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "premise",
                "locality",
                "postcode"
              ],
              "properties": {
                "premise": {
                  "type": "boolean"
                },
                "locality": {
                  "type": "boolean"
                },
                "postcode": {
                  "type": "boolean"
                }
              }
            },
            "disposition": {
              "type": "string",
              "enum": [
                "PENDING",
                "SELECTED_EXACT",
                "NOT_SELECTED",
                "AMBIGUOUS_EXACT",
                "REFUSED",
                "REFUSED_RETRIEVAL",
                "AMBIGUOUS",
                "SELECTED_FOR_RETURN_CHECK",
                "REFUSED_RETURN_CHECK",
                "SELECTED_CORRECTED"
              ]
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "selected_candidate": {
        "type": [
          "string",
          "null"
        ]
      },
      "selected_candidate_index": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "operation": {
        "type": "string",
        "enum": [
          "NONE",
          "NO_CHANGE",
          "PROPOSE_CANONICAL_CANDIDATE"
        ]
      },
      "return_check": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "passed",
              "checks"
            ],
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "premise",
                  "locality",
                  "postcode",
                  "street_within_one_edit"
                ],
                "properties": {
                  "premise": {
                    "type": "boolean"
                  },
                  "locality": {
                    "type": "boolean"
                  },
                  "postcode": {
                    "type": "boolean"
                  },
                  "street_within_one_edit": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        ]
      },
      "terminal_state": {
        "type": "string",
        "enum": [
          "VERIFIED",
          "CORRECTED",
          "UNRESOLVED"
        ]
      },
      "reason_code": {
        "type": "string",
        "minLength": 1
      },
      "evidence_class": {
        "type": "string",
        "enum": [
          "SUFFICIENT_AND_CONSISTENT",
          "INSUFFICIENT",
          "CONFLICTING",
          "AMBIGUOUS",
          "MIXED"
        ]
      },
      "reason_codes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "trace_id": {
        "type": "string",
        "pattern": "^addr-[0-9a-f]{16}$"
      },
      "ruleset_version": {
        "type": "string",
        "const": "synthetic-address-demo/1.0"
      },
      "trace_schema_version": {
        "type": "string",
        "const": "candidate-trace/1.0"
      },
      "normalisation_rule": {
        "type": "string",
        "const": "text-only Unicode casefold plus whitespace collapse"
      },
      "candidate_trace_audit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "valid",
          "mismatches",
          "candidate_count",
          "field_comparison_count"
        ],
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "mismatches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 0
          },
          "field_comparison_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "fieldComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_value",
        "candidate_value",
        "both_text_and_nonblank",
        "intended_normalised",
        "candidate_normalised",
        "normalised_equal"
      ],
      "properties": {
        "intended_value": {},
        "candidate_value": {},
        "both_text_and_nonblank": {
          "type": "boolean"
        },
        "intended_normalised": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_normalised": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalised_equal": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
